# ---------------------------------------------------------------------------
# R
# ---------------------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
.Renviron
# renv library (keep renv.lock, ignore the local library)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Data (do not commit large / raw datasets)
# ---------------------------------------------------------------------------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.geojson
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.tif
*.tiff
*.nc
*.zip

# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------
output/*
figures/*
!output/.gitkeep
!figures/.gitkeep

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
